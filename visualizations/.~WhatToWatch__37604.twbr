      <aliases enabled='yes' />
      <column caption='range of years' datatype='string' name='[Calculation_0402426433589249]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(MIN([year])) + &quot; – &quot; + STR(MAX([year]))' />
      </column>
      <column caption='genre_pairs' datatype='string' name='[Calculation_2694839048417280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [genre] &lt; [genre (film_genres.csv1)]&#10;AND [genre] != [genre (film_genres.csv1)]&#10;THEN [genre] + &quot; &amp; &quot; + [genre (film_genres.csv1)]&#10;END' />
      </column>
      <column datatype='string' name='[Rating_bechdel (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[rating]' new-bin='true'>
          <bin default-name='false' value='&quot;Fail&quot;'>
            <value>0</value>
            <value>1</value>
            <value>2</value>
          </bin>
          <bin default-name='false' value='&quot;Pass&quot;'>
            <value>3</value>
          </bin>
        </calculation>
      </column>
      <column aggregation='None' datatype='integer' name='[Runtime Min (bin)]' role='dimension' type='quantitative'>
